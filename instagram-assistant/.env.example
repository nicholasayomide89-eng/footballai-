# --- Keel (the app itself) ---
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://keel:keel@localhost:5432/keel
# Session signing key: `openssl rand -base64 48`
SESSION_SECRET=
# Owner login: run `npm run hash-password` and paste the output here.
OWNER_PASSWORD_HASH=
# 32-byte key for encrypting Instagram tokens at rest: `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=

# --- Meta / Instagram (Instagram API with Instagram Login) ---
# From developers.facebook.com > your app > Instagram > API setup with Instagram login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v24.0
# Any random string; paste the same value into the Meta webhook configuration.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Media storage (S3-compatible). Meta fetches Story media from a public URL,
# so Keel hands it a short-lived presigned URL. ---
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
